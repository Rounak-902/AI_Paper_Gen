# Copy this file to infra/.env and replace every placeholder with a unique,
# URL-safe random value. infra/.env is ignored by Git.
POSTGRES_PASSWORD=replace_with_unique_random_postgres_password
PAPERGEN_APP_DB_PASSWORD=replace_with_unique_random_app_user_password
REDIS_PASSWORD=replace_with_unique_random_redis_password
MINIO_ROOT_USER=papergen_local_admin
MINIO_ROOT_PASSWORD=replace_with_unique_random_minio_password

# REDIS_PASSWORD is the one source of truth for local Redis credentials. Run
# Sync-PaperGenBackendRedisEnv from scripts/local-infra-env.ps1 to derive the
# authenticated backend REDIS_URL (DB 0) and QUEUE_REDIS_URL (DB 1).

# Optional loopback-only host port overrides.
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
