# Browser-to-FastAPI requests. Public values are embedded at build time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-side auth BFF requests.
API_BASE_URL=http://127.0.0.1:8000

# Keep false only for local HTTP. Production HTTPS deployments should omit this
# value (secure cookies are the production default) or set it to true.
AUTH_COOKIE_SECURE=false
