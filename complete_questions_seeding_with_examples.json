    "stem": "Exercise 2.1 Question 4: Two angles of a triangle measure $50^\\circ$ and $60^\\circ$. Find the measure of the third angle.",
    "marks": 2,
    "difficulty": "easy",
    "bloom": "apply",
    "language": "en",
    "source": "textbook",
    "scope": "org",
    "board_code": "CBSE",
    "class_name": "Grade 6",
    "subject_name": "Mathematics",
    "chapter_name": "Lines and Angles",
    "options_json": [],
    "answer_json": {
      "text": "Sum of angles in a triangle = 180 degrees.\nThird angle = 180 - (50 + 60) = 180 - 110 = 70 degrees."
    },
    "rubric_json": {
      "key_points": [
