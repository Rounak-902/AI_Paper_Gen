# =============================================================================
# AI Question Paper Generation Platform - Environment Configuration Template
# =============================================================================
# NOTE: This file contains placeholder defaults for reference.
# Copy this file to .env and fill in real secrets before running.
# Never commit actual secret keys or credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Server
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/papergen
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_SSL=false

# -----------------------------------------------------------------------------
# 3. Redis & Queue (Celery)
# -----------------------------------------------------------------------------
# Local development: derive these authenticated URLs from infra/.env by running
# Sync-PaperGenBackendRedisEnv in scripts/local-infra-env.ps1.
REDIS_URL=redis://:CHANGEME@127.0.0.1:6379/0
QUEUE_REDIS_URL=redis://:CHANGEME@127.0.0.1:6379/1
REDIS_TLS=false
REDIS_MAX_RETRIES=3
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
QUESTION_IMPORT_BATCH_SIZE=250
QUESTION_IMPORT_STALE_SECONDS=300
NOTIFICATION_EVENT_POLL_SECONDS=2
NOTIFICATION_DIGEST_CADENCE_SECONDS=300
NOTIFICATION_QUESTION_REVIEW_THRESHOLD=10
NOTIFICATION_EMAIL_MAX_RETRIES=3
NOTIFICATION_EVENT_MAX_RETRIES=3
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=notifications@papergen.local
SMTP_TIMEOUT_SECONDS=10
SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
TASK_IDEMPOTENCY_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# 4. Authentication & Security
# -----------------------------------------------------------------------------
# Minimum 32-character high-entropy secret string
JWT_SECRET=CHANGEME_USE_A_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGEME_USE_A_STRONG_RANDOM_REFRESH_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=4

# -----------------------------------------------------------------------------
# 5. AI Configuration (Gemini & Software-First Pipeline)
# -----------------------------------------------------------------------------
# Gemini API Key
GEMINI_API_KEY=CHANGEME_GEMINI_API_KEY
AI_PROVIDER=gemini

# Model Tier IDs (REQUIRED, no default in code - concrete IDs are a deployment
# decision, see docs/06_AI_Architecture.md §25.1. The app refuses to boot if unset.)
AI_MODEL_GENERATE=CHANGEME_GEMINI_PRO_MODEL_ID
AI_MODEL_CLASSIFY=CHANGEME_GEMINI_FLASH_MODEL_ID
AI_EMBEDDING_MODEL=CHANGEME_GEMINI_EMBEDDING_MODEL_ID

# Model & Generation Parameters
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_RETRY_COUNT=2
AI_GENERATION_TIMEOUT_MS=30000
AI_SAFETY_THRESHOLD=block_medium_and_above
AI_ESCALATION_THINKING_BUDGET=4096
AI_TENANT_TOKEN_BUDGET=100000

# Keep these synchronized with the configured Gemini tier prices. Values are
# USD per million input/output tokens; application code deliberately has no
# dated provider price table.
AI_COST_FLASH_INPUT_PER_MILLION_USD=0
AI_COST_FLASH_OUTPUT_PER_MILLION_USD=0
AI_COST_PRO_INPUT_PER_MILLION_USD=0
AI_COST_PRO_OUTPUT_PER_MILLION_USD=0
AI_COST_ESCALATION_INPUT_PER_MILLION_USD=0
AI_COST_ESCALATION_OUTPUT_PER_MILLION_USD=0

# Pipeline Gates & Timeouts
AI_SOLVER_TIME_BUDGET_MS=2000
AI_VERIFY_SANDBOX_TIMEOUT_MS=2000
CLASSIFICATION_FALLBACK_THRESHOLD=0.7
TEMPLATE_GENERATION_ENABLED=true
AI_QUALITY_THRESHOLD=0.70
AI_QUALITY_AUTO_ACCEPT=0.85
AI_SIMILARITY_THRESHOLD=0.92
AI_TOP_K_RETRIEVAL=20
AI_FALLBACK_PROVIDER=

# Retrieval & Hybrid Search Weights (MVP: lexical + trigram; Vector disabled by default)
AI_HYBRID_WEIGHT_METADATA=0.4
AI_HYBRID_WEIGHT_FTS=0.4
AI_HYBRID_WEIGHT_TRIGRAM=0.2
AI_HYBRID_WEIGHT_VECTOR=0.0
AI_VECTOR_SEARCH_ENABLED=false

# Inert Vector & Embedding Settings (Gated for post-MVP adoption per ADR-007)
AI_EMBEDDING_DIMENSIONS=1536
AI_BATCH_EMBED_SIZE=2048
AI_HNSW_M=16
AI_HNSW_EF_CONSTRUCTION=200
AI_HNSW_EF_SEARCH=100

# -----------------------------------------------------------------------------
# 6. Object Storage (S3 / MinIO)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=papergen-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=CHANGEME_MINIO_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGEME_MINIO_SECRET_KEY
STORAGE_USE_SSL=false
EXPORT_SIGNED_URL_TTL_SECONDS=3600
EXPORT_RENDER_TIMEOUT_SECONDS=120
EXPORT_RENDERER_NODE_BINARY=node

# -----------------------------------------------------------------------------
# 7. OCR Configuration (P7 Ingestion Pipeline)
# -----------------------------------------------------------------------------
OCR_PROVIDER=mathpix
MATHPIX_APP_ID=CHANGEME_MATHPIX_APP_ID
MATHPIX_APP_KEY=CHANGEME_MATHPIX_APP_KEY

# -----------------------------------------------------------------------------
# 8. Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_ORG=1000
LOGIN_RATE_LIMIT=50

# -----------------------------------------------------------------------------
# 9. Observability & Monitoring
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_ENDPOINT=
